# ─────────────────────────────────────────────────────────────
# Supervisão de Atendimento — variáveis de ambiente
# Copie para ".env" (desenvolvimento) ou para /etc/supervisao/supervisao.env
# (produção, permissão 600). Nunca versione arquivos com valores reais.
# ─────────────────────────────────────────────────────────────

# Conexão PostgreSQL (usuário dedicado, sem privilégios de superusuário).
# Banco no mesmo servidor:  postgresql://supervisao:SENHA@localhost:5432/supervisao?schema=public
# Banco em outro servidor:  postgresql://supervisao:SENHA@10.0.0.20:5432/supervisao?schema=public&sslmode=require
DATABASE_URL="postgresql://supervisao:TROQUE_ESTA_SENHA@localhost:5432/supervisao?schema=public"

# Banco SEPARADO usado apenas pelos testes automatizados (opcional em produção).
TEST_DATABASE_URL="postgresql://supervisao:TROQUE_ESTA_SENHA@localhost:5432/supervisao_test?schema=public"

# Segredo aleatório (mín. 32 caracteres) usado para HMAC de IPs no limite de tentativas.
# Gere com:  openssl rand -hex 32
SESSION_SECRET="gere-um-valor-aleatorio-com-openssl-rand-hex-32"

# Fuso horário para "hoje", prazos e exibição de horários.
APP_TIMEZONE="America/Sao_Paulo"

# Validade deslizante da sessão, em horas (padrão 12).
SESSION_TTL_HOURS="12"

# "true" exige HTTPS para o cookie de sessão (padrão em produção).
# Use "false" somente se a aplicação for acessada por HTTP puro dentro de rede confiável.
COOKIE_SECURE="true"

# Diretório PRIVADO para anexos (fora de public/, sem acesso direto pelo servidor web).
ATTACHMENTS_DIR="/var/lib/supervisao/anexos"

# Diretório dos dumps gerados por deploy/backup.sh (lido apenas para exibir status).
BACKUP_DIR="/var/backups/supervisao"

# Porta/host do servidor Next.js (atrás do proxy reverso).
PORT="3000"
HOSTNAME="127.0.0.1"

# WhatsApp (Evolution API, não oficial) — opcional. Sem estas variáveis os envios ficam desativados.
# A Evolution API roda no próprio servidor (docker), ouvindo só em 127.0.0.1. Veja docs/IMPLANTACAO.md.
# EVOLUTION_API_URL="http://127.0.0.1:8080"
# EVOLUTION_API_KEY="chave-gerada-na-instalacao"
# EVOLUTION_INSTANCE="supervisao"
